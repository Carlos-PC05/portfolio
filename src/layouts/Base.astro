---
import '../styles/global.css';
import { ui, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.meta} />
    <meta name="theme-color" content="#0a5c34" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.meta} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a5c34'/%3E%3Cpath d='M16 3v26M16 16m-7 0a7 7 0 1 0 14 0a7 7 0 1 0-14 0' stroke='%23f4f6f1' stroke-width='2' fill='none'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip t-label" href="#main">{t.skip}</a>
    <slot />

    <script is:inline>
      /* Vanishing spray. The cursor image is CSS; this only lays the droplets
         it leaves on the grass and lets them evaporate. No rAF loop: pointermove
         is already coalesced to one event per frame, so an idle page costs zero. */
      (function () {
        if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var layer = document.createElement('div');
        layer.className = 'spray';
        layer.setAttribute('aria-hidden', 'true');
        document.body.appendChild(layer);

        var lx = 0,
          ly = 0,
          onGrass = false;

        addEventListener(
          'pointermove',
          function (e) {
            var el = e.target;
            if (
              e.pointerType !== 'mouse' ||
              !el.closest ||
              !el.closest('.pitch') ||
              el.closest('.sheet, .board')
            ) {
              onGrass = false;
              return;
            }

            var dx = e.clientX - lx,
              dy = e.clientY - ly;
            /* one droplet per ~18px travelled: a nozzle, not a firehose */
            if (onGrass && dx * dx + dy * dy < 324) return;
            lx = e.clientX;
            ly = e.clientY;
            onGrass = true;

            var s = 4 + Math.random() * 5;
            var d = document.createElement('i');
            d.style.cssText =
              'left:' +
              (e.clientX + (Math.random() - 0.5) * 12 - s / 2) +
              'px;top:' +
              (e.clientY + (Math.random() - 0.5) * 12 - s / 2) +
              'px;width:' +
              s +
              'px;height:' +
              s +
              'px';
            d.addEventListener('animationend', function () {
              d.remove();
            });
            layer.appendChild(d);

            /* a backgrounded tab never fires animationend — cap the layer */
            if (layer.childElementCount > 120) layer.firstElementChild.remove();
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
